# End-to-end test environment (`npm run test:e2e`), loaded by `vite --mode e2e`. It
# overrides .env and .env.local, so the tests never touch your database, Redis, Blob
# store, mail server or AI provider. Committed on purpose: nothing here is a secret.
DATABASE_URL=
LOS_PGLITE_DIR=memory://
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
LOS_LOCAL_BLOB_DIR=.e2e/blob
LOS_LOCAL_KV_FILE=.e2e/kv.json
EMAIL_HOST=invalid.invalid
EMAIL_PORT=2525
LOS_DEV_LOG_CODES=true
LOS_DEMO_ENABLED=true
LOS_ADMIN_EMAIL=
LOS_ADMIN_PASSWORD=
LOS_SECRETS_KEY=e2e-only-not-a-secret
GEMINI_API_KEY=
LMS_PROVIDER=none
LMS_BASE_URL=
CRB_PROVIDER=demo
VITE_CRB_ENABLED=true
GEOCODER=
