# Copy to /etc/los.env (chmod 600, owner root). Read by systemd, not by a shell.
NODE_ENV=production
PORT=3001
APP_URL=https://loans.example.com
# Set false only for isolated, trusted HTTP networks; session cookies then travel unencrypted.
# SESSION_COOKIE_SECURE=false
# Offer letters and loan agreements name the lender as the brand (Settings → Branding).
# Set this only when the lender's legal name differs from it.
# LENDER_NAME=
DATABASE_URL=postgres://los:CHANGE_ME@127.0.0.1:5432/los_db

# openssl rand -base64 32  (changing it later means re-entering LMS/SMS credentials)
LOS_SECRETS_KEY=
# openssl rand -hex 32
CRON_SECRET=

# State lives outside the code directory so updates never touch it.
LOS_LOCAL_BLOB_DIR=/var/lib/los/blob
LOS_LOCAL_KV_FILE=/var/lib/los/kv.json
BLOB_ACCESS=private

# Must be false here: the "ignored on Vercel" guard does not apply on Linux.
LOS_DEV_LOG_CODES=false
# Leave LOS_DEMO_ENABLED unset.

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional
# GEMINI_API_KEY=       (or set up AI providers in Settings → AI document checks;
#                        other providers' variables are listed in .env.example)
# CRB_PROVIDER=          (unset = off; "demo" gives fake scores; "product109" is the
#                        real bureau and needs the CRB_* variables in .env.example)
# CLAMAV_HOST=

# Admin tools that delete records wholesale or change how long loan records are kept.
# Off on a server unless set to true; switch one on only while it's needed, then remove it
# and restart. (On a developer's machine they're on; set false to hide them there.)
#   Settings → Danger zone (Wipe data)
# LOS_DATA_WIPE_ENABLED=true
#   Settings → Data retention (the daily clean-up applies the saved periods either way)
# LOS_RETENTION_SETTINGS_ENABLED=true
