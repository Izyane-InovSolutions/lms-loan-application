# The address people open, e.g. the Cloudflare Tunnel's public hostname. Used in emailed links.
APP_URL=https://loans.example.com

# tunnel = Cloudflare Tunnel (no open ports); https = Caddy with Let's Encrypt on ports 80/443.
# Add ,clamav for virus scanning.
COMPOSE_PROFILES=tunnel
# From Cloudflare: Zero Trust → Networks → Tunnels → your tunnel → token.
TUNNEL_TOKEN=
# Behind Cloudflare the visitor's address is in this header. Remove it with the https profile.
CLIENT_IP_HEADER=cf-connecting-ip
# Only with the https profile: the hostname Caddy gets its certificate for.
# DOMAIN=loans.example.com
# APP_PORT=3001

TZ=Africa/Lusaka

# Wrap values containing special characters in single quotes, e.g. PASSWORD='a)b*c'.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
LOS_SECRETS_KEY=

LOS_ADMIN_EMAIL=
LOS_ADMIN_PASSWORD=
LOS_ADMIN_NAME=

# Gmail needs an app password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

LOS_MAINTENANCE_HOUR=3
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=14

# Built into the site: change, then rebuild (./update.sh).
VITE_CRB_ENABLED=true
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION='&copy; OpenStreetMap contributors'

# Credit bureau: "demo" = labelled sample scores, "product109" = the real bureau, unset = off.
CRB_PROVIDER=product109
CRB_WSDL_URL=https://secure3.crbafrica.com/crbws/zm?wsdl
CRB_TRANSPORT_USERNAME=
CRB_TRANSPORT_PASSWORD=
CRB_MESSAGE_USERNAME=
CRB_MESSAGE_PASSWORD=
CRB_CODE=
CRB_INFINITY_CODE=
CRB_REPORT_REASON=2
CRB_REPORT_SECTOR=2
CRB_TIMEOUT_SECONDS=30
# Bureau certificate from a private CA: mount the PEM into the app container and point at it.
# CRB_CA_FILE=
# Leave unset: the image runs in production, where a test identity is refused and every pull fails.
# CRB_TEST_IDENTITY=

# AI document checks (or set up in Settings → AI document checks).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Address-distance check: sends applicants' addresses to the geocoder.
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org

# --- Optional ----------------------------------------------------------------------------
# Offer letters name the lender as the brand (Settings → Branding); set only if different.
# LENDER_NAME=
# Virus scanning (with the clamav profile above).
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=false
# Frappe LMS: set up in Settings → LMS connection.
# Postgres connections per app instance (default 10).
# DB_POOL_MAX=10
# Seconds an AI check may take; keep under 100 behind Cloudflare (default 85).
# AI_TIMEOUT_SECONDS=85
