{
  "crons": [
    { "path": "/api/cron/purge-expired-drafts", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "api/cron/purge-expired-drafts.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/erp-api/:path*", "destination": "https://api.erp.lms.rolaface.com/:path*" },
    { "source": "/((?!api/|erp-api/).*)", "destination": "/index.html" }
  ]
}
