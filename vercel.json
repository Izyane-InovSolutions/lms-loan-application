{
  "crons": [
    {
      "path": "/api/cron/purge-expired-drafts",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/cron/purge-expired-drafts.js": {
      "maxDuration": 60
    },
    "api/ai/*.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
