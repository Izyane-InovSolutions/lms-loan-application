# Environment variables
VITE_API_URL=http://localhost:8000
# Leave as /erp-api in every environment: vite.config.js proxies it to the LMS host in
# dev, and the /erp-api rewrite in vercel.json does the same on Vercel. Pointing it at
# the LMS host directly makes the browser call cross-origin, which the LMS does not allow.
VITE_LMS_API_URL=/erp-api

# Draft resume mini-backend (api/*).
#
# KV_REST_API_URL/KV_REST_API_TOKEN come from a Redis store — on Vercel, add Upstash
# Redis from Storage → Marketplace and link it to the project; the integration injects
# both. BLOB_READ_WRITE_TOKEN comes from a linked Vercel Blob store. With neither set,
# `npm run dev` falls back to .local-kv.json / .local-blob on disk (see api/_lib), so
# local work needs no Vercel project; a Vercel deployment without them fails loudly.
# Vars are per-environment on Vercel, so set them for Preview as well as Production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional: protects the daily cron cleanup endpoint from being triggered by anyone else.
# Vercel sends it automatically as `Authorization: Bearer <CRON_SECRET>` when it is set.
CRON_SECRET=
