# Environment variables
VITE_API_URL=http://localhost:8000
VITE_LMS_API_URL=/erp-api

# Draft resume mini-backend (api/*) — populated automatically in Vercel once the
# KV store, Blob store, and Resend integration are linked to the project. Copy
# the real values from the Vercel dashboard into a local .env for `vercel dev`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: protects the daily cron cleanup endpoint from being triggered by anyone else
CRON_SECRET=

