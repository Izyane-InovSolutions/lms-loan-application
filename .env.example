# Environment variables
VITE_API_URL=http://localhost:8000
VITE_LMS_API_URL=/erp-api

# Draft resume mini-backend (api/*) — KV_REST_API_URL/TOKEN and BLOB_READ_WRITE_TOKEN
# are populated automatically in Vercel once the KV store and Blob store are linked
# to the project. Copy the real values from the Vercel dashboard into a local .env
# for `vercel dev`. EMAIL_* below are SMTP settings for sending the OTP email.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional: protects the daily cron cleanup endpoint from being triggered by anyone else
CRON_SECRET=

