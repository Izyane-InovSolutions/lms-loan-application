# Environment variables
VITE_API_URL=http://localhost:8000
# Leave as /erp-api in every environment: vite.config.js proxies it to the LMS host in
# dev, and the /erp-api rewrite in vercel.json does the same on Vercel. Pointing it at
# the LMS host directly makes the browser call cross-origin, which the LMS does not allow.
VITE_LMS_API_URL=/erp-api

# Leave unset in every environment: the draft mini-backend below is served by this
# project's own api/* functions at /api. Only set this if those functions ever move
# to a separate host — pointing it at /erp-api 404s (that rewrite is the LMS host).
# VITE_DRAFT_API_URL=

# Draft resume mini-backend (api/*).
#
# KV_REST_API_URL/KV_REST_API_TOKEN come from a Redis store — on Vercel, add Upstash
# Redis from Storage → Marketplace and link it to the project; the integration injects
# both. BLOB_READ_WRITE_TOKEN comes from a linked Vercel Blob store. With neither set,
# `npm run dev` falls back to .local-kv.json / .local-blob on disk (see api/_lib), so
# local work needs no Vercel project; a Vercel deployment without them fails loudly.
# Vars are per-environment on Vercel, so set them for Preview as well as Production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional: protects the daily cron cleanup endpoint from being triggered by anyone else.
# Vercel sends it automatically as `Authorization: Bearer <CRON_SECRET>` when it is set.
CRON_SECRET=

# AI prescreening and document checks (api/ai/*). Server-side only — never prefix these
# with VITE_, or the key ships to every browser. With no provider configured the wizard
# simply hides the AI notes; nothing else changes.
#
# Gemini (default). Use a key from a billed Google Cloud project: on the free tier Google
# may use submitted content to improve its models, and these are NRCs and bank statements.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
#
# Self-hosted Gemma (or any OpenAI-compatible server: Ollama, vLLM, llama.cpp):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://your-gpu-host:11434/v1
# AI_MODEL=gemma3:27b
# AI_API_KEY=
#
# Per-applicant cap on model calls per day (cost guard). Default 60.
# AI_DAILY_LIMIT_PER_APPLICANT=60
#
# Send the staff-facing prescreen result to the LMS as `ai_prescreening` on submit. Leave
# off until the Frappe Custom Loan Application doctype has a field to store it.
# VITE_AI_PRESCREEN_TO_LMS=true
