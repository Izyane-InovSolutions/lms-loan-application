# Environment variables
DATABASE_URL=

LOS_DEV_LOG_CODES=true

# Try the credit bureau panel with sample scores.
CRB_PROVIDER=demo
VITE_CRB_ENABLED=true

# CRB_PROVIDER=product109: the bureau's Product 109 SOAP service. Server-side only —
# never prefix these with VITE_. Values come from the bureau contract; the existing
# Django adapter names them CRB_BASE_URL, CRB_TRANSPORT_PASS, CRB_MESSAGE_PASS and
# INFINITY_CODE. Certificates are always verified: if the bureau's certificate comes
# from a private CA, put that CA's PEM file on the server and point CRB_CA_FILE at it.
# CRB_WSDL_URL=https://…?wsdl
# CRB_TRANSPORT_USERNAME=
# CRB_TRANSPORT_PASSWORD=
# CRB_MESSAGE_USERNAME=
# CRB_MESSAGE_PASSWORD=
# CRB_CODE=
# CRB_INFINITY_CODE=
# CRB_REPORT_REASON=2
# CRB_REPORT_SECTOR=2
# CRB_TIMEOUT_SECONDS=30
# CRB_CA_FILE=
# UAT only: "NRC|other names|surname" of the bureau's test person, sent instead of the
# applicant (a test account knows only its test identities). Reports are labelled as
# the test person's; the setting is refused in production.
# CRB_TEST_IDENTITY=

VITE_API_URL=https://api.erp.lms.rolaface.com
VITE_LMS_API_URL=/erp-api

KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Required on a deployment: the daily maintenance job refuses to run without it.
CRON_SECRET=
# The site's address, the base of emailed links. Required in production for password
# links, which never use the request's Host header (on Vercel the project URL is used).
APP_URL=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Daily caps on AI calls: per applicant, per caller address, and for the whole deployment.
# AI_DAILY_LIMIT_PER_APPLICANT=60
# AI_DAILY_LIMIT_PER_IP=300
# AI_DAILY_LIMIT_GLOBAL=5000

GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org

VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# The product's name and logo are set in Settings → Branding. Offer letters and loan
# agreements ({{lender_name}}) name the lender the same way; set this only when the
# lender's legal name differs from the brand.
# LENDER_NAME=
