# Environment variables. Copy to .env.local for local overrides (gitignored).

# Loan workspace database: users, applications, rules, settings, audit log.
# Any Postgres: Neon from Vercel → Storage → Marketplace is the easy route (use the
# pooled "-pooler" host). Leave unset locally and `npm run dev` uses an in-process
# PGlite database in .local-pg/ with no install. After adding a migration, run
# `DATABASE_URL=… npm run db:migrate` against the hosted database before deploying.
DATABASE_URL=
# Base URL for links in invitation and password emails. Falls back to the request host.
# APP_URL=https://loans.example.com
#
# The first administrator: used once, on the first sign-in attempt while no staff
# account exists. Afterwards invite everyone from Team in /admin.
LOS_ADMIN_EMAIL=
LOS_ADMIN_PASSWORD=
LOS_ADMIN_NAME=
#
# "Try a role" sample sign-in on /admin/login. On by default locally, off on Vercel
# unless set to true (e.g. for a demo deployment). Never enable it on production data.
# LOS_DEMO_ENABLED=true

# Leave unset in every environment: the draft mini-backend below is served by this
# project's own api/* functions at /api. Only set this if those functions ever move
# to a separate host.
# VITE_DRAFT_API_URL=

# Draft resume mini-backend (api/*).
#
# KV_REST_API_URL/KV_REST_API_TOKEN come from a Redis store — on Vercel, add Upstash
# Redis from Storage → Marketplace and link it to the project; the integration injects
# both. BLOB_READ_WRITE_TOKEN comes from a linked Vercel Blob store. With neither set,
# `npm run dev` falls back to .local-kv.json / .local-blob on disk (see api/_lib), so
# local work needs no Vercel project; a Vercel deployment without them fails loudly.
# Vars are per-environment on Vercel, so set them for Preview as well as Production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional: protects the daily cron cleanup endpoint from being triggered by anyone else.
# Vercel sends it automatically as `Authorization: Bearer <CRON_SECRET>` when it is set.
CRON_SECRET=

# AI prescreening and document checks (api/ai/*). Server-side only — never prefix these
# with VITE_, or the key ships to every browser. With no provider configured the wizard
# simply hides the AI notes; nothing else changes.
#
# Admins can instead set everything in Settings → AI document checks and switch there
# without a restart: the model (Gemini, Mistral, Claude, OpenAI, Azure OpenAI, Gemini on
# Vertex AI, AWS Bedrock or self-hosted), fallbacks for when it is busy, and an optional
# OCR step (Mistral OCR, Azure Document Intelligence, Google Document AI, AWS Textract).
# Any field left blank in Settings falls back to the variable below; the full list of
# variables is in src/config/aiProviders.js (the `env` of each field).
#
# Gemini (default). Use a key from a billed Google Cloud project: on the free tier Google
# may use submitted content to improve its models, and these are NRCs and bank statements.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
#
# Other providers (AI_PROVIDER=mistral | anthropic | openai | azure-openai | vertex | bedrock):
# MISTRAL_API_KEY=                  MISTRAL_MODEL=mistral-small-latest
# ANTHROPIC_API_KEY=                ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=                   OPENAI_MODEL=gpt-5.6
# AZURE_OPENAI_ENDPOINT=            AZURE_OPENAI_API_KEY=         AZURE_OPENAI_DEPLOYMENT=
# GOOGLE_SERVICE_ACCOUNT_JSON=      VERTEX_LOCATION=global        VERTEX_MODEL=gemini-3.8-flash
# AWS_ACCESS_KEY_ID=                AWS_SECRET_ACCESS_KEY=        AWS_REGION=us-east-1   BEDROCK_MODEL=
#
# Self-hosted Gemma (or any OpenAI-compatible server: Ollama, vLLM, llama.cpp):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://your-gpu-host:11434/v1
# AI_MODEL=gemma3:27b
# AI_API_KEY=
#
# Per-applicant cap on model calls per day (cost guard). Default 60.
# AI_DAILY_LIMIT_PER_APPLICANT=60

# Encrypts credentials that admins enter in Settings (LMS secret or password, SMS and AI keys).
# Required on Vercel before any can be saved; any long random string, e.g.
# `openssl rand -base64 32`. Changing it means re-entering those credentials.
LOS_SECRETS_KEY=

# Frappe LMS (optional — the workspace runs without it). The easiest way is Settings →
# LMS connection in the workspace, with "Test connection". These variables are an
# alternative, used only while that screen's connection is switched off. Server-side only.
LMS_BASE_URL=https://api.erp.lms.rolaface.com
LMS_API_KEY=
LMS_API_SECRET=
LMS_USERNAME=
LMS_PASSWORD=
LMS_PROVIDER=none              # force the LMS off even when LMS_BASE_URL is set

# Document storage. Set BLOB_ACCESS=private when the linked Blob store is private
# (recommended: NRCs and bank statements). Files are then only served through the
# workspace's own signed-in routes.
BLOB_ACCESS=private

# Credit bureau. Leave unset until a bureau contract exists; "demo" gives labelled
# sample scores for walkthroughs. VITE_CRB_ENABLED shows the consent box to applicants.
CRB_PROVIDER=demo
VITE_CRB_ENABLED=true

# Distance between the applicant's shared location and their stated address. Sends the
# address to the geocoder, so only enable it where the privacy notice covers that.
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org

# Map tiles on the case page (OpenStreetMap's public tiles are for light use only).
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Local testing without a mail server: print one-time codes to the server console when
# the email cannot be sent. Ignored on Vercel. Never set it in production.
LOS_DEV_LOG_CODES=true

# Virus scanning of uploads (optional): a clamd server. If it is unreachable, uploads are
# still accepted and the failure logged — unless CLAMAV_REQUIRED=true.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=false

# Browser errors are reported to Admin → System health in production builds. Set this to
# also report them from `npm run dev`.
# VITE_REPORT_DEV_ERRORS=true
